{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["MAIN_DATABASE_URL", "TENANT_DATABASE_URL"]
    },
    "generate": {
      "dependsOn": ["^generate"],
      "inputs": ["prisma/**", ".env*"],
      "outputs": ["generated/**"],
      "env": ["MAIN_DATABASE_URL", "TENANT_DATABASE_URL"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["MAIN_DATABASE_URL", "TENANT_DATABASE_URL"]
    }
  }
}
