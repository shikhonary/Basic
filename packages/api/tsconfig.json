{
  "extends": "@workspace/typescript-config/base.json",
  "compilerOptions": {
    /**
     * "Bundler" mode — designed for packages consumed by a bundler (Next.js,
     * Vite, etc.). Unlike NodeNext, it does NOT require .js extensions on
     * relative imports, which is the standard TypeScript style.
     *
     * @see https://www.typescriptlang.org/tsconfig#moduleResolution
     */
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "jsx": "react-jsx"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
